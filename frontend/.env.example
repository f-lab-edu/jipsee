API_URL=http://localhost:8080
SITE_URL=http://localhost:3000

# 백엔드가 없는 동안 쓰는 목업 기본값. 개발 서버를 다시 띄워야 반영됨
# 요청의 쿠키(jipsee-mock-session, jipsee-mock-chat)가 이 값보다 앞서며, 운영 빌드(NODE_ENV=production)에서는 둘 다 무시함
# MOCK_SESSION: KAKAO, GOOGLE, NAVER이면 그 제공자로 로그인한 상태이고 비우거나 none이면 로그아웃 상태
# MOCK_SESSION=KAKAO
# MOCK_CHAT: normal(기본), dailyLimit, serverError, rateLimit, noHistory
# MOCK_CHAT=normal
# MOCK_BUILDING: none(기본), searchFailed, searchRateLimited, buildingFailed, buildingRateLimited. 검색 결과와 건물 상세의 실패 화면을 확인할 때 씀. 쿠키 jipsee-mock-building이 앞섬
# MOCK_BUILDING=none
