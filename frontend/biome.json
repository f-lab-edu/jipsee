{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": ["**", "!.next", "!next-env.d.ts"]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				"noUndeclaredVariables": "error",
				"useHookAtTopLevel": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "error",
				"noDuplicateElseIf": "error",
				"noEvolvingTypes": "error"
			},
			"style": {
				"noNestedTernary": "error",
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useConst": "error",
				"useTemplate": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["camelCase"]
					}
				}
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noImgElement": "error",
				"noReExportAll": "error",
				"noBarrelFile": "error"
			},
			"a11y": {
				"useAltText": "error",
				"useButtonType": "error",
				"useValidAnchor": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["PascalCase"]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["app/**", "*.config.ts", ".dependency-cruiser.js"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		}
	]
}
