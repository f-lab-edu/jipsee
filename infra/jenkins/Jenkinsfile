// 종료 코드를 Jenkins 결과로 변환
String mapResult(String job, int code) {
  if (code == 0) { return 'SUCCESS' }
  if (code == 75) {
    if (job.startsWith('initial')) {
      currentBuild.description = (currentBuild.description ?: '') + "${job}: 한도 도달, 내일 이어감\n"
      return 'SUCCESS'
    }
    return 'UNSTABLE'
  }
  if (code == 143 || code == 137) { return 'ABORTED' }
  return 'FAILURE'  // 1, 2, 3, 125-127과 그 밖의 값
}

// 배포된 이미지 태그를 .env.deploy의 IMAGE_TAG 줄에서 읽음. 파일이나 줄이 없으면 빈 문자열
String readTag() {
  String file = '/etc/jipsee/.env.deploy'
  if (!fileExists(file)) { return '' }
  for (String line : readFile(file).split('\n')) {
    if (line.startsWith('IMAGE_TAG=')) { return line.substring('IMAGE_TAG='.length()).trim() }
  }
  return ''
}

// Job 컨테이너를 멈춤. 이미 끝났으면 오류가 나도 무시
void stopJob(String job) {
  sh(returnStatus: true, script: "docker stop -t 60 jipsee-job-${job} >/dev/null 2>&1")
}

// Job 하나를 실행하고 결과를 스테이지와 빌드에 반영
void runJob(String job, int minutes) {
  catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
    int code = 255
    try {
      timeout(time: minutes, unit: 'MINUTES') {
        String tag = readTag()
        if (!tag) { error("${job} .env.deploy의 IMAGE_TAG를 읽지 못함") }
        currentBuild.description = (currentBuild.description ?: '') + "${job}: 이미지 태그 ${tag}\n"
        withEnv(["JOB=${job}", "TAG=${tag}"]) {
          code = sh(returnStatus: true, script: '''docker run --rm --name "jipsee-job-$JOB" \\
  --network jipsee-db --memory 1g --cpus 2 --stop-timeout 60 \\
  --log-opt max-size=10m --log-opt max-file=3 \\
  -e SPRING_PROFILES_ACTIVE=prod \\
  -e SPRING_MAIN_WEB_APPLICATION_TYPE=none \\
  -e SPRING_MAIN_BANNER_MODE=off \\
  -e "JIPSEE_BATCH_RUN_JOB=$JOB" \\
  --env-file /etc/jipsee/job.env \\
  "ghcr.io/f-lab-edu/jipsee-backend:$TAG"
''')
        }
      }
    } finally {
      stopJob(job)
    }
    String result = mapResult(job, code)
    echo "${job} 종료 코드 ${code} 결과 ${result}"
    if (result != 'SUCCESS') {
      catchError(buildResult: result, stageResult: result) { error("${job} 종료 코드 ${code}") }
    }
  }
}

pipeline {
  agent any
  options {
    // Jenkinsfile이 작업 폴더 파일을 쓰지 않으므로 저장소 체크아웃 생략, 체크아웃 실패가 실패 웹훅을 막지 않음
    skipDefaultCheckout()
    timeout(time: 180, unit: 'MINUTES')
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }
  // 트리거는 빌드가 실행될 때 등록됨. 첫 수동 빌드로 등록
  triggers {
    cron('TZ=Asia/Seoul\n0 4 * * *')
  }
  stages {
    stage('dailyRentCollectJob')  { steps { script { runJob('dailyRentCollectJob', 30) } } }
    stage('dailySaleCollectJob')  { steps { script { runJob('dailySaleCollectJob', 30) } } }
    stage('initialRentLoadJob')   { steps { script { runJob('initialRentLoadJob', 60) } } }
    stage('initialSaleLoadJob')   { steps { script { runJob('initialSaleLoadJob', 60) } } }
  }
  post {
    // 실패, 불안정, 중단 빌드를 웹훅으로 한 번 알림. ALERT_WEBHOOK_URL은 컨트롤러 환경 변수
    // 변수가 비어 있으면 알림 생략. 전송 실패는 빌드 결과에 반영하지 않음. shebang으로 set -x를 막아 URL이 콘솔에 남지 않음
    unsuccessful {
      withEnv(["ALERT_JOB=${env.JOB_NAME}", "ALERT_RESULT=${currentBuild.currentResult}", "ALERT_URL=${env.BUILD_URL}"]) {
        sh(returnStatus: true, script: '''#!/bin/sh
[ -n "$ALERT_WEBHOOK_URL" ] || exit 0
curl -fsS -m 10 -H 'Content-Type: application/json' \\
  -d "{\\"job\\":\\"$ALERT_JOB\\",\\"result\\":\\"$ALERT_RESULT\\",\\"url\\":\\"$ALERT_URL\\"}" \\
  "$ALERT_WEBHOOK_URL" >/dev/null
''')
      }
    }
  }
}
