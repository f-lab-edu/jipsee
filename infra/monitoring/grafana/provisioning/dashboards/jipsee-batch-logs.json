      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"jenkins\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
